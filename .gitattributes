# Normalização de fim de linha (evita os avisos LF/CRLF no Windows)
* text=auto eol=lf
*.png binary
*.pdf binary
*.zip binary
*.geojson text eol=lf
*.Rproj text eol=crlf

# Atos normativos baixados do DOU (fonte, não código): fora das estatísticas de linguagem do GitHub
data/legal/**/*.html linguist-vendored=true
